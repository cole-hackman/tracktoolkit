// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  soundcloudId Int      @unique
  username     String
  displayName  String?
  avatarUrl    String?
  /// Stamped by the OAuth callback on every login. Drives the inactive-account
  /// purge in server/lib/retention.js; null on rows that predate the column,
  /// which fall back to updatedAt there.
  lastLoginAt    DateTime?
  /// Set when the user disconnects (POST /api/auth/disconnect) or when
  /// SoundCloud reports the authorization revoked. Tokens are already gone by
  /// then; the row itself is purged six days later by the retention job.
  disconnectedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tokens                Token[]
  operationLogs         OperationLog[]
  surveyResponses       SurveyResponse[]
  growthActions         GrowthAction[]
  betaSignups           BetaSignup[]
  rebrandVotes          RebrandVote[]
  feedback              Feedback[]
  experimentExposures   ExperimentExposure[]
  // Tables owned by other feature branches (AI library chat, library indexing).
  // Declared here so `prisma db push` from this branch does not drop live
  // production data. Keep in sync when those branches change their schema.
  chatConversations     chat_conversations[]
  indexedLikes          indexed_likes[]
  indexedPlaylistTracks indexed_playlist_tracks[]
  librarySnapshot       library_snapshots?
  libraryCachePages     LibraryCachePage[]
  libraryCacheStates    LibraryCacheState[]

  @@index([lastLoginAt])
  @@index([disconnectedAt])
  @@map("users")
}

/// Counters that must outlive the rows they were computed from. Never keyed
/// to a user, so nothing here is in the account-deletion cascade.
///
/// `lifetime_registered_users` and `lifetime_tracks_processed` (each with a
/// `…_through` cursor) are running totals the retention job extends before it
/// deletes anything; `lifetime_distinct_users` is their retired predecessor.
///
/// `experiment_enrolled:<experiment>:<variant>` counts every exposure ever
/// recorded for that arm (server/lib/experiments.js). The exposure rows leave
/// with their account, so this is what shows how many enrolled users have
/// since been deleted from each arm.
model Metric {
  key       String   @id
  value     BigInt
  updatedAt DateTime @updatedAt

  @@map("metrics")
}

model SurveyResponse {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId     BigInt
  campaignId       String
  preference       String // 'ads' | 'pro' | 'donation' | 'none' | 'other'
  lifetimeInterest String? // 'interested' | 'not_interested' | 'maybe'
  comment          String?  @db.Text
  context          String // 'dashboard' | 'post-merge' | 'post-from-likes'
  operationAction  String? // 'merge' | 'from-likes'
  trackCount       Int?
  createdAt        DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId, createdAt])
  @@index([preference])
  @@index([lifetimeInterest])
  @@index([soundcloudId])
  @@map("survey_responses")
}

model RebrandVote {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId BigInt
  campaignId   String
  // Slug of the shortlisted name they picked, or 'none' / 'no_preference'.
  nameChoice   String
  // Their own suggestion — free text, independent of nameChoice.
  nameIdea     String?
  // Feature request / anything they want built next.
  featureIdea  String?  @db.Text
  context      String // dashboard | post-merge | post-from-likes
  createdAt    DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId, createdAt])
  @@index([nameChoice])
  @@index([soundcloudId])
  @@map("rebrand_votes")
}

/// In-app feedback — the "Send feedback" form. Login-required, so every row is
/// attributable and the honeypot plus the per-user limiter are enough; there is
/// no email delivery, no webhook and no third-party widget. `message` and
/// `email` are the only free text a user supplies, and neither is ever logged.
///
/// `messageHash` is the sha256 of the whitespace-collapsed, lowercased message.
/// It exists so a double-submit (or a user re-sending the same report because
/// nothing visibly happened) is answered 409 instead of filling the inbox with
/// duplicates — matched against the same user's last 24 hours, which is what
/// the ([userId, messageHash, createdAt]) index serves.
model Feedback {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId Int
  type         String // bug | feature | other
  message      String   @db.Text
  // Route the feedback was sent from, e.g. "/playlist-keyword-search".
  page         String?
  // Optional reply address. Absent unless the user typed one.
  email        String?
  // Coarse device/browser/platform from extractClientInfo() — no IP, no raw UA.
  clientInfo   Json?
  status       String   @default("new") // new | seen | done | spam
  // Admin-only triage note. Never returned by any non-admin route.
  adminNote    String?  @db.Text
  messageHash  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, messageHash, createdAt])
  @@map("feedback")
}

/// One row per (user, experiment): the arm the user was assigned to, written
/// the first time they could see a difference between the arms and never
/// again (server/lib/experiments.js). The unique pair is what makes "once per
/// user per experiment" a property of the database rather than of the code
/// that writes it.
///
/// Kept while the account exists and deleted with it, like `OperationLog`:
/// there is no purge by age. `createdAt` is the exposure time; the user's
/// first login is `users."createdAt"`.
model ExperimentExposure {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Flag key from server/lib/flags.js, e.g. "guided-first-run".
  experimentKey String
  variant       String
  createdAt     DateTime @default(now())

  @@unique([userId, experimentKey])
  @@index([experimentKey, variant])
  @@map("experiment_exposures")
}

model BetaSignup {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId     BigInt
  campaignId       String
  email            String? // PII — required only when wantsBeta is true
  rekordboxUse     String // rekordbox_primary | rekordbox_sometimes | other_software | no
  platform         String? // mac | windows | both
  cullMethod       String? // dont | manual | tedious | other_tool
  featuresWanted   String? // comma-separated slugs
  editHesitations  String? // comma-separated slugs
  trustDirectWrite String? // yes | maybe | xml_only
  interest         String // very | somewhat | not
  wantsBeta        Boolean  @default(false)
  wantsCall        Boolean  @default(false)
  suggestions      String?  @db.Text // ideas for the toolkit or SongSwipe
  nameIdea         String? // product name suggestion
  context          String // dashboard | post-merge | post-from-likes
  createdAt        DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId, createdAt])
  @@index([interest])
  @@index([wantsBeta])
  @@index([soundcloudId])
  @@map("beta_signups")
}

model Token {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encrypted String // Encrypted access token
  refresh   String // Encrypted refresh token
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@map("tokens")
}

model OperationLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundcloudId Int?
  action       String // 'merge' | 'from-likes' | 'bulk-unlike' | 'bulk-unfollow' | 'resolve' | 'batch-resolve' | 'proxy-download' | 'bulk-remove-reposts'
  status       String   @default("success") // 'success' | 'split' | 'error'
  trackCount   Int      @default(0)
  itemCount    Int      @default(0)
  durationMs   Int?
  errorCode    String?
  errorMessage String?
  metadata     Json?
  clientInfo   Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([soundcloudId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([soundcloudId, createdAt])
  @@index([action, createdAt])
  // GIN index so admin catalog queries can unnest metadata->'trackIds' without scans
  @@index([metadata], type: Gin)
  @@map("operation_logs")
}

// ── Music catalog ───────────────────────────────────────────────────────────
// One row per SoundCloud track/playlist ever touched by an operation. Rows are
// harvested at zero API cost from track objects the app already fetches
// (playlists, likes pages, search, resolve) and enriched by ID for the rest.
// Public metadata only; not keyed to any user.

model Track {
  id              BigInt   @id // SoundCloud track ID (exceeds int32)
  title           String?
  artistName      String?
  artistId        BigInt?
  genre           String?
  genreNormalized String?
  durationMs      Int?
  access          String? // playable | preview | blocked | gone (deleted upstream)
  permalinkUrl    String?
  resolveStatus   String   @default("pending") // pending | resolved | not_found | gone
  resolveAttempts Int      @default(0)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@index([genreNormalized])
  @@index([artistName])
  @@index([resolveStatus])
  @@index([access])
  @@index([lastSeenAt])
  @@map("tracks")
}

model Playlist {
  id          BigInt   @id // SoundCloud playlist ID
  title       String?
  ownerScId   BigInt?
  trackCount  Int?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@map("playlists")
}

model GrowthAction {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType       String // 'follow' | 'like'
  targetId         BigInt // SC user ID or track ID — track IDs already exceed int32
  targetName       String?
  targetAvatar     String?
  targetFollowers  Int?
  targetFollowings Int?
  followedBack     Boolean? // null = unchecked, true = yes, false = no
  checkedAt        DateTime?
  reversed         Boolean   @default(false)
  reversedAt       DateTime?
  sessionId        String?
  sessionLabel     String?
  inspirationIds   String? // comma-separated SC user IDs
  inspirationNames String? // comma-separated usernames, parallel to inspirationIds
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, actionType])
  @@index([userId, reversed])
  @@index([userId, sessionId])
  @@index([userId, followedBack])
  @@index([createdAt])
  @@map("growth_actions")
}

// ── Tables owned by other feature branches ──────────────────────────────────
// Reconstructed via `prisma db pull` from production Neon so that db push /
// migrations from this branch do not drop live data. If you merge the AI-chat
// or library-indexing branches, reconcile these with those branches' models.

model chat_conversations {
  id            String          @id
  userId        String
  title         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  users         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat_messages chat_messages[]

  @@index([userId, updatedAt])
}

model chat_messages {
  id                 String             @id
  conversationId     String
  role               String
  content            String?
  toolName           String?
  toolArgs           Json?
  toolResult         Json?
  createdAt          DateTime           @default(now())
  chat_conversations chat_conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model indexed_likes {
  id              String    @id
  userId          String
  trackId         BigInt
  title           String?
  artistName      String?
  artistId        BigInt?
  genre           String?
  genreNormalized String?
  tagList         String?
  durationMs      Int?
  likedAt         DateTime?
  access          String?
  users           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, artistName])
  @@index([userId, genreNormalized])
}

model indexed_playlist_tracks {
  id            String  @id
  userId        String
  playlistId    BigInt
  playlistTitle String?
  trackId       BigInt
  users         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId, trackId])
  @@index([userId, playlistId])
}

model library_snapshots {
  id                String    @id
  userId            String    @unique
  status            String    @default("stale")
  likeCount         Int       @default(0)
  playlistCount     Int       @default(0)
  likesSyncedAt     DateTime?
  playlistsSyncedAt DateTime?
  error             String?
  updatedAt         DateTime
  users             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Persisted page of a user's SoundCloud collection.
///
/// The in-memory request cache dies on every deploy and is per-process, so a
/// restart puts every user back on a cold multi-page crawl. This is the tier
/// that survives that.
///
/// Stored one row per page rather than one blob per collection: a blob for a
/// 20k-like library is tens of megabytes in a single row, and one row per item
/// means reassembling the array on every read. Page rows also let the crawl
/// write incrementally, so a reader can have page 1 while page 20 is still in
/// flight — which is what makes progressive loading possible.
model LibraryCachePage {
  id        String   @id @default(cuid())
  userId    String
  /// likes | playlists | followings | followers | reposts
  resource  String
  pageIndex Int
  /// The SoundCloud objects for this page, verbatim.
  items     Json
  itemCount Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, pageIndex])
  @@index([userId, resource])
  @@map("library_cache_pages")
}

/// Sync state for one (user, resource) snapshot. Separate from the pages so
/// invalidation is a single cheap UPDATE that marks the snapshot stale while
/// leaving it readable — a stale snapshot still beats a cold crawl, and the
/// refresh happens behind it.
model LibraryCacheState {
  id          String    @id @default(cuid())
  userId      String
  resource    String
  /// stale | syncing | complete | error
  status      String    @default("stale")
  /// Total items in the completed snapshot; null while it has never completed.
  totalItems  Int?
  pagesSynced Int       @default(0)
  /// True when the underlying crawl hit its page or time budget.
  truncated   Boolean   @default(false)
  syncedAt    DateTime?
  error       String?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
  @@index([userId])
  @@map("library_cache_states")
}
